{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Validation error without name",
      "method": "POST",
      "path": "/",
      "body": {"phone": "+7 (931) 002-82-22"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Method not allowed",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    },
    {
      "name": "Honeypot filled is silently accepted",
      "method": "POST",
      "path": "/",
      "body": {"name": "Bot", "phone": "+7 900 000-00-00", "website": "http://spam.example"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    }
  ]
}