# Apache: отдаём готовые страницы пререндера, а не SPA-заглушку.
Options -MultiViews
ErrorDocument 404 /404.html

RewriteEngine On

# Существующие файлы и каталоги — напрямую
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# {путь}/index.html из пререндера
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*?)/?$ /$1/index.html [L]

# Ничего не нашли — 404, а не главная
RewriteRule ^ - [R=404,L]

# Кеш: файлы с хешем в имени не меняются
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|webp|png|jpg|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
